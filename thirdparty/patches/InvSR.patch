+def image_is_valid(path: str | Path) -> bool:
+    p = Path(path)
+    if not p.is_file():                    # 1️⃣  does the file exist?
+        return False
+    try:
+        # 2️⃣  verify header (cheap)
+        with Image.open(p) as img:
+            img.verify()                   # raises if header is corrupt
+
